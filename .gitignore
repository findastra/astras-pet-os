art/imports/

# Windows companion builds are reproducible from source.
bin/

# Local Unity tool inventory, paths and execution reports never ship as source.
apps/unity-unicorn-local-tools-*.js

# Local service addresses (ports) for this PC only; public pages name the services, never the address.
# See docs/local-services-20261014.md.
apps/*-local-services-*.js

# Local reference book includes third-party screenshots; publish only original concept plates.
