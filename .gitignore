node_modules/
.env
.env.*
.claude/
.DS_Store
Thumbs.db

# Intermediate 64px conversions written by generate-pets.mjs. The frames in art/frames/
# are what ship; these are only a fallback source for a pet whose sheet has gone missing.
art/generated/

# External reference artwork stays local until redistribution is permitted.
art/imports/

# Windows companion builds are reproducible from source.
bin/

# Local Unity tool inventory, paths and execution reports never ship as source.
apps/unity-unicorn-local-tools-*.js

# Local service addresses (ports) for this PC only; public pages name the services, never the address.
# See docs/local-services-20261014.md.
apps/*-local-services-*.js

# Pet packs built by scripts/pet-packs-20261020.mjs: zips with pictures copied in, never committed (one art source).
pet-packs/

# A farm's own record of what it runs (scripts/farm-lock-20261021.mjs, Astra's answer 1, 2026-10-21): it lives on the
# computer, in the farm's own folder, and is never committed. An installed farm keeps its release's list of pets in
# farm-catalog/.
farm-lock-20261021.json
farm-catalog/

# Serena (docs/cung-list-20261026.md): .serena/project.yml is shared; the notes an agent writes into its memories stay
# on the PC. Serena's own .serena/.gitignore keeps its cache and project.local.yml out.
.serena/memories/
